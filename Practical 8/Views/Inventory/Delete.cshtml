@model Practical_8.Models.Product

@{
    ViewBag.Title = "Delete Product";
}

<link href="@Url.Content("~/Content/Site.css")" rel="stylesheet" />

<style>
    .delete-page {
        max-width: 760px;
        margin: 45px auto;
        padding: 0 18px;
    }

    .delete-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 12px 35px rgba(15, 23, 42, 0.09);
    }

    .delete-header {
        padding: 28px 32px;
        background: #fff7f7;
        border-bottom: 1px solid #fee2e2;
        display: flex;
        align-items: center;
        gap: 18px;
    }

    .warning-icon {
        width: 58px;
        height: 58px;
        min-width: 58px;
        border-radius: 16px;
        background: #fee2e2;
        color: #dc2626;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 29px;
        font-weight: 700;
    }

    .delete-header h2 {
        margin: 0 0 7px;
        color: #991b1b;
        font-size: 25px;
        font-weight: 700;
    }

    .delete-header p {
        margin: 0;
        color: #64748b;
        font-size: 14px;
        line-height: 1.6;
    }

    .delete-content {
        padding: 30px 32px;
    }

    .warning-message {
        background: #fff7ed;
        border: 1px solid #fed7aa;
        color: #9a3412;
        border-radius: 10px;
        padding: 14px 16px;
        margin-bottom: 26px;
        font-size: 14px;
        line-height: 1.6;
    }

    .details-title {
        color: #334155;
        font-size: 16px;
        font-weight: 700;
        margin: 0 0 16px;
    }

    .product-details {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
    }

    .detail-item {
        padding: 16px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        min-width: 0;
    }

    .detail-label {
        display: block;
        color: #64748b;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        margin-bottom: 7px;
    }

    .detail-value {
        display: block;
        color: #0f172a;
        font-size: 16px;
        font-weight: 600;
        overflow-wrap: anywhere;
    }

    .delete-actions {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 12px;
        padding: 22px 32px;
        background: #f8fafc;
        border-top: 1px solid #e2e8f0;
    }

    .delete-actions .btn {
        margin: 0;
        padding: 12px 20px;
        border-radius: 8px;
        font-size: 14px;
    }

    .delete-actions .btn-danger {
        background: #dc2626;
        color: #ffffff !important;
    }

    .delete-actions .btn-danger:hover {
        background: #b91c1c;
    }

    .delete-actions .btn-secondary {
        background: #ffffff;
        color: #334155 !important;
        border: 1px solid #cbd5e1;
    }

    .delete-actions .btn-secondary:hover {
        background: #f1f5f9;
    }

    
        .delete-header,
        .delete-content {
            padding: 22px 18px;
        }

        .delete-header h2 {
            font-size: 21px;
        }

        .product-details {
            grid-template-columns: 1fr;
        }

        .delete-actions {
            padding: 18px;
            flex-direction: column-reverse;
        }

        .delete-actions .btn {
            width: 100%;
            text-align: center;
        }
    }
</style>

<div class="delete-page">
    <div class="delete-card">

        <div class="delete-header">
            <div class="warning-icon">!</div>

            <div>
                <h2>Delete Product</h2>
                <p>Review the product information before confirming deletion.</p>
            </div>
        </div>

        <div class="delete-content">

            <div class="warning-message">
                <strong>Warning:</strong>
                You are about to permanently delete this product from your inventory.
                This action cannot be undone.
            </div>

            <h3 class="details-title">Product Information</h3>

            <div class="product-details">
                <div class="detail-item">
                    <span class="detail-label">Product ID</span>
                    <span class="detail-value">@Model.ProductId</span>
                </div>

                <div class="detail-item">
                    <span class="detail-label">Product Name</span>
                    <span class="detail-value">@Model.ProductName</span>
                </div>

                <div class="detail-item">
                    <span class="detail-label">Category</span>
                    <span class="detail-value">@Model.Category</span>
                </div>

                <div class="detail-item">
                    <span class="detail-label">Quantity</span>
                    <span class="detail-value">@Model.Quantity units</span>
                </div>

                <div class="detail-item">
                    <span class="detail-label">Price</span>
                    <span class="detail-value">@Model.Price.ToString("N2")</span>
                </div>
            </div>

        </div>

        <div class="delete-actions">
            @Html.ActionLink(
                "Cancel",
                "Index",
                "Inventory",
                null,
                new { @class = "btn btn-secondary" }
            )

            @using (Html.BeginForm(
                "Delete",
                "Inventory",
                new { id = Model.ProductId },
                FormMethod.Post,
                new { style = "display:inline;" }))
            {
                @Html.AntiForgeryToken()

                <button type="submit" class="btn btn-danger">
                    Delete Product
                </button>
            }
        </div>

    </div>
</div>